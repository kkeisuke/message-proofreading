{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "src/routeTree.gen.ts"
  ],
  "plugins": [
    "react",
    "jsx-a11y",
    "promise"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    // React 19 + automatic JSX ランタイム（tsconfig.json の jsx: "react-jsx",
    // @vitejs/plugin-react）を使用しており、JSX 変換に `React` の import は不要。
    // このルールはクラシックランタイム前提で automatic ランタイムを認識しないため、
    // 全 JSX ファイルで誤検知する。個別に無効化する。
    "react/react-in-jsx-scope": "off",
    // role="radio" に矢印キー操作を実装していない既知の課題（別途対応予定）。
    // 対処せず報告のみに留めるため、lint を通す目的で warn に留める。
    "jsx-a11y/prefer-tag-over-role": "warn"
  }
}
